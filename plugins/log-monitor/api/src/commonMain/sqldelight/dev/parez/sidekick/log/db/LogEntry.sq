CREATE TABLE LogEntry (
    id        TEXT    NOT NULL PRIMARY KEY,
    timestamp INTEGER NOT NULL,
    level     TEXT    NOT NULL,
    tag       TEXT    NOT NULL,
    message   TEXT    NOT NULL,
    throwable TEXT,
    metadata  TEXT
);

CREATE INDEX IF NOT EXISTS LogEntry_timestamp_idx ON LogEntry(timestamp DESC);
CREATE INDEX IF NOT EXISTS LogEntry_level_idx ON LogEntry(level);

selectAll:
SELECT * FROM LogEntry ORDER BY timestamp DESC;

selectPagedFiltered:
SELECT * FROM LogEntry
WHERE (tag LIKE :likeToken OR message LIKE :likeToken)
  AND level IN :levels
ORDER BY timestamp DESC
LIMIT :limit OFFSET :offset;

selectPagedFilteredAllLevels:
SELECT * FROM LogEntry
WHERE (tag LIKE :likeToken OR message LIKE :likeToken)
ORDER BY timestamp DESC
LIMIT :limit OFFSET :offset;

countFiltered:
SELECT COUNT(*) FROM LogEntry
WHERE (tag LIKE :likeToken OR message LIKE :likeToken)
  AND level IN :levels;

countFilteredAllLevels:
SELECT COUNT(*) FROM LogEntry
WHERE (tag LIKE :likeToken OR message LIKE :likeToken);

selectById:
SELECT * FROM LogEntry WHERE id = ?;

insertEntry:
INSERT INTO LogEntry(id, timestamp, level, tag, message, throwable, metadata)
VALUES (?, ?, ?, ?, ?, ?, ?);

deleteAll:
DELETE FROM LogEntry;

deleteOlderThan:
DELETE FROM LogEntry WHERE timestamp < ?;

countAll:
SELECT COUNT(*) FROM LogEntry;

deleteOldestOverLimit:
DELETE FROM LogEntry WHERE id IN (
    SELECT id FROM LogEntry ORDER BY timestamp ASC LIMIT ?
);
