CREATE TABLE NetworkCall (
    id                TEXT    NOT NULL PRIMARY KEY,
    url               TEXT    NOT NULL,
    method            TEXT    NOT NULL,
    requestHeaders    TEXT    NOT NULL,
    requestBody       TEXT,
    requestTimestamp  INTEGER NOT NULL,
    responseCode      INTEGER,
    responseHeaders   TEXT    NOT NULL DEFAULT '{}',
    responseBody      TEXT,
    responseTimestamp INTEGER,
    error             TEXT,
    status            TEXT    NOT NULL DEFAULT 'PENDING'
);

CREATE INDEX IF NOT EXISTS NetworkCall_requestTimestamp_idx ON NetworkCall(requestTimestamp DESC);
CREATE INDEX IF NOT EXISTS NetworkCall_method_idx ON NetworkCall(method);

selectAll:
SELECT * FROM NetworkCall ORDER BY requestTimestamp DESC;

selectPagedFiltered:
SELECT * FROM NetworkCall
WHERE (url LIKE :likeToken OR method LIKE :likeToken)
  AND method IN :methods
ORDER BY requestTimestamp DESC
LIMIT :limit OFFSET :offset;

selectPagedFilteredAllMethods:
SELECT * FROM NetworkCall
WHERE (url LIKE :likeToken OR method LIKE :likeToken)
ORDER BY requestTimestamp DESC
LIMIT :limit OFFSET :offset;

countFiltered:
SELECT COUNT(*) FROM NetworkCall
WHERE (url LIKE :likeToken OR method LIKE :likeToken)
  AND method IN :methods;

countFilteredAllMethods:
SELECT COUNT(*) FROM NetworkCall
WHERE (url LIKE :likeToken OR method LIKE :likeToken);

selectById:
SELECT * FROM NetworkCall WHERE id = ?;

insertCall:
INSERT INTO NetworkCall(id, url, method, requestHeaders, requestBody, requestTimestamp, status)
VALUES (?, ?, ?, ?, ?, ?, 'PENDING');

updateResponse:
UPDATE NetworkCall
SET responseCode = ?, responseHeaders = ?, responseBody = ?, responseTimestamp = ?, status = 'COMPLETE'
WHERE id = ?;

updateResponseBody:
UPDATE NetworkCall
SET responseBody = ?
WHERE id = ?;

updateError:
UPDATE NetworkCall
SET error = ?, status = 'ERROR'
WHERE id = ?;

deleteAll:
DELETE FROM NetworkCall;

deleteOlderThan:
DELETE FROM NetworkCall WHERE requestTimestamp < ?;

countAll:
SELECT COUNT(*) FROM NetworkCall;

deleteOldestOverLimit:
DELETE FROM NetworkCall WHERE id IN (
    SELECT id FROM NetworkCall ORDER BY requestTimestamp ASC LIMIT ?
);
